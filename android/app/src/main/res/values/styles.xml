<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Alles schwarz: Fenster, Status- und Navigationsleiste, keine Titelleiste.
         Die Fassungen in values-v29 und values-v31 ergaenzen nur neuere Android-Eigenschaften. -->
    <style name="Base.Theme.JKHD" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Monochrom: Auswahl, Schalter, Cursor in Hell statt in der Material-Akzentfarbe -->
        <item name="android:colorAccent">@color/text_hell</item>
        <item name="android:colorPrimary">@color/kachel_flaeche</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorControlNormal">@color/text_gedaempft</item>
        <item name="android:colorControlActivated">@color/text_hell</item>
        <item name="android:colorControlHighlight">@color/kachel_druck</item>
        <item name="android:textColorPrimary">@color/text_hell</item>
        <item name="android:textColorSecondary">@color/text_gedaempft</item>
        <item name="android:textColorHint">@color/text_gedaempft</item>
        <item name="android:colorEdgeEffect">@color/kachel_rand_hell</item>
    </style>

    <style name="Theme.JKHD" parent="Base.Theme.JKHD" />

    <!-- Bausteine der Oberflaeche (Bereich Webseite) -->

    <!-- Kleine Kennzeile ueber einem Block, wie der Kicker der Website -->
    <style name="Kicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:tag">mono</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_gedaempft</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Ueberschrift einer Seite (Playfair Display) -->
    <style name="Ueberschrift">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:tag">serif</item>
        <item name="android:textColor">@color/text_hell</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- Titel eines Abschnitts im Formular -->
    <style name="Abschnitt">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_hell</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Beschriftung ueber einem Feld -->
    <style name="Beschriftung">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_gedaempft</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Fliesstext -->
    <style name="Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_gedaempft</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Eingabefeld -->
    <style name="Eingabe">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/eingabe_hintergrund</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text_hell</item>
        <item name="android:textColorHint">@color/text_gedaempft</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Knoepfe: hell (Hauptaktion), umrandet (Zweitaktion), rot umrandet (Gefahr) -->
    <style name="Knopf">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Knopf.Primaer">
        <item name="android:background">@drawable/knopf_primaer</item>
        <item name="android:textColor">@color/knopf_primaer_text</item>
    </style>

    <style name="Knopf.Zweit">
        <item name="android:background">@drawable/knopf_zweit</item>
        <item name="android:textColor">@color/text_hell</item>
    </style>

    <style name="Knopf.Gefahr">
        <item name="android:background">@drawable/knopf_gefahr</item>
        <item name="android:textColor">@color/gefahr</item>
    </style>

    <!-- Kleiner Textknopf, z. B. in einer Zeile -->
    <style name="Knopf.Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/text_hell</item>
        <item name="android:textStyle">normal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- Hinweiskasten (Beanstandungen, Fehler) -->
    <style name="Hinweis">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/hinweis_hintergrund</item>
        <item name="android:padding">12dp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_hell</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Eingabefeld: dunkle Flaeche, feiner Rand, im Fokus hellerer Rand. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kachel_flaeche" />
            <stroke android:width="1dp" android:color="@color/text_gedaempft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kachel_flaeche" />
            <stroke android:width="1dp" android:color="@color/kachel_rand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

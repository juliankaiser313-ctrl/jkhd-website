<?xml version="1.0" encoding="utf-8"?>
<!-- Hintergrund eines Vierecks: dunkle Flaeche mit feinem Rand und runden Ecken,
     beim Druecken ein heller Schimmer (Ripple), auf die runden Ecken begrenzt. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kachel_druck">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/kachel_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kachel_flaeche" />
            <stroke
                android:width="1dp"
                android:color="@color/kachel_rand" />
            <corners android:radius="@dimen/kachel_radius" />
        </shape>
    </item>
</ripple>

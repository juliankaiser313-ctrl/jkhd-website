<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 15 zeichnet das System Apps von Rand zu Rand. Diese App verzichtet darauf (noch):
         so bleiben Status- und Navigationsleiste schwarze Balken, und Formulare rücken bei
         eingeblendeter Tastatur zuverlässig nach oben (adjustResize). Rest wie values-v31. -->
    <style name="Theme.JKHD" parent="Base.Theme.JKHD">
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>

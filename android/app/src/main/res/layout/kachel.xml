<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Viereck auf dem Startbildschirm: Nummer oben links, Titel und Untertitel unten links,
     alles in einer Spalte, damit sich nichts überlagert; der Zwischenraum dehnt sich.
     Quadratisch durch QuadratKachel (Höhe = Breite; nur bei sehr großer Systemschrift höher). -->
<de.jkhd.app.QuadratKachel xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kachel_hintergrund"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/kachel_innen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kachel_nummer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textColor="@color/text_gedaempft"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/kachel_titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/text_hell"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/kachel_untertitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="@color/text_gedaempft"
            android:textSize="11sp" />
    </LinearLayout>

</de.jkhd.app.QuadratKachel>

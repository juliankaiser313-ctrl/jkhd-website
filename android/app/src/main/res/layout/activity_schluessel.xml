<?xml version="1.0" encoding="utf-8"?>
<!-- Schlüssel der Verwaltung eingeben (einmalig). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/seitenrand">

        <TextView
            android:id="@+id/zurueck"
            style="@style/Knopf.Text"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="16sp"
            android:text="@string/zurueck" />

        <TextView
            style="@style/Kicker"
            android:layout_marginTop="28dp"
            android:text="@string/ws_kicker" />

        <TextView
            style="@style/Ueberschrift"
            android:layout_marginTop="10dp"
            android:text="@string/ws_schluessel_titel" />

        <TextView
            style="@style/Text"
            android:layout_marginTop="12dp"
            android:text="@string/ws_schluessel_text" />

        <TextView
            style="@style/Beschriftung"
            android:layout_marginTop="20dp"
            android:text="@string/ws_schluessel_hinweis" />

        <EditText
            android:id="@+id/schluessel"
            style="@style/Eingabe"
            android:fontFamily="monospace"
            android:tag="mono"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textMultiLine|textVisiblePassword"
            android:minLines="3" />

        <TextView
            android:id="@+id/meldung"
            style="@style/Hinweis"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/speichern"
            style="@style/Knopf.Primaer"
            android:layout_marginTop="20dp"
            android:text="@string/ws_schluessel_speichern" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Bereich Multi-Broker: die Trading-Oberfläche vom PC (über Tailscale) im Vollbild.
     Oben ein dünner Ladebalken; lädt die Seite nicht, liegt statt eines schwarzen Bildes die
     Fehleransicht mit „Erneut versuchen“ darüber. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/ladebalken"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressDrawable="@drawable/ladebalken"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/fehler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/seitenrand">

            <TextView
                style="@style/Kicker"
                android:text="@string/mb_kicker" />

            <TextView
                style="@style/Ueberschrift"
                android:layout_marginTop="10dp"
                android:text="@string/mb_fehler_titel" />

            <TextView
                style="@style/Text"
                android:layout_marginTop="12dp"
                android:text="@string/mb_fehler_text" />

            <TextView
                android:id="@+id/fehler_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:tag="mono"
                android:textColor="@color/text_gedaempft"
                android:textSize="12sp" />

            <Button
                android:id="@+id/erneut"
                style="@style/Knopf.Primaer"
                android:layout_marginTop="24dp"
                android:text="@string/mb_erneut" />

            <Button
                android:id="@+id/adresse_aendern"
                style="@style/Knopf.Zweit"
                android:layout_marginTop="10dp"
                android:text="@string/mb_adresse_aendern" />

            <TextView
                android:id="@+id/zurueck"
                style="@style/Knopf.Text"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:text="@string/zurueck" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Bereich Webseite: die Partnerliste (das Gegenstück zur linken Spalte der PC-App). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/seitenrand"
            android:paddingTop="@dimen/seitenrand"
            android:paddingEnd="@dimen/seitenrand"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/zurueck"
                    style="@style/Knopf.Text"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:text="@string/zurueck" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/rollen"
                    style="@style/Knopf.Text"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/ws_rollen" />

                <TextView
                    android:id="@+id/neu_laden"
                    style="@style/Knopf.Text"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/ws_neu_laden" />
            </LinearLayout>

            <TextView
                style="@style/Kicker"
                android:layout_marginTop="12dp"
                android:text="@string/ws_kicker" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/Ueberschrift"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:text="@string/ws_titel" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/text_gedaempft"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/fehler"
                style="@style/Hinweis"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/nochmal"
                style="@style/Knopf.Zweit"
                android:layout_marginTop="8dp"
                android:text="@string/ws_nochmal"
                android:visibility="gone" />

            <EditText
                android:id="@+id/suche"
                style="@style/Eingabe"
                android:layout_marginTop="12dp"
                android:hint="@string/ws_suche"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions" />

            <Button
                android:id="@+id/partner_neu"
                style="@style/Knopf.Primaer"
                android:layout_marginTop="10dp"
                android:text="@string/ws_partner_neu" />
        </LinearLayout>

        <TextView
            android:id="@+id/leer"
            style="@style/Text"
            android:paddingStart="@dimen/seitenrand"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/seitenrand"
            android:visibility="gone" />

        <ListView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="8dp"
            android:paddingStart="@dimen/seitenrand"
            android:paddingTop="4dp"
            android:paddingEnd="@dimen/seitenrand"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <!-- Speicherleiste: erscheint, sobald etwas geändert ist -->
        <LinearLayout
            android:id="@+id/speicherleiste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/kachel_flaeche"
            android:orientation="vertical"
            android:padding="@dimen/seitenrand"
            android:visibility="gone">

            <TextView
                android:id="@+id/speicher_text"
                style="@style/Text"
                android:textColor="@color/text_hell" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/verwerfen"
                    style="@style/Knopf.Zweit"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/ws_verwerfen" />

                <Button
                    android:id="@+id/speichern"
                    style="@style/Knopf.Primaer"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/ws_speichern" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/schluessel_entfernen"
            style="@style/Knopf.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/text_gedaempft"
            android:textSize="12sp"
            android:text="@string/ws_schluessel_entfernen" />

    </LinearLayout>

    <include layout="@layout/ladebildschirm" />

</FrameLayout>

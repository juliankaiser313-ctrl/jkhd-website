<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Datei des Partners: Typ, Name, Größe · Datum, Beschreibung, Entfernen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/karte_hintergrund"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/datei_typ"
            style="@style/Kicker"
            android:background="@drawable/knopf_zweit"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/datei_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_hell"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/datei_entfernen"
            style="@style/Knopf.Text"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@color/text_gedaempft"
            android:textSize="18sp"
            android:text="@string/ws_entfernen_zeile" />
    </LinearLayout>

    <TextView
        android:id="@+id/datei_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_gedaempft"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/datei_text"
        style="@style/Eingabe"
        android:layout_marginTop="8dp"
        android:hint="@string/ws_datei_text"
        android:importantForAutofill="no"
        android:inputType="text|textCapSentences"
        android:maxLines="2"
        android:textSize="14sp" />

</LinearLayout>

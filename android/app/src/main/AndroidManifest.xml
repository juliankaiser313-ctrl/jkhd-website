<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bereich Webseite: spricht mit https://api.jkhd.de -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.JKHD"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Startbildschirm mit den Vierecken der Bereiche -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Seite eines Bereichs (noch Platzhalter) -->
        <activity
            android:name=".BereichActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Bereich Webseite: Partnerverwaltung -->
        <activity
            android:name=".webseite.WebseiteActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".webseite.SchluesselActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".webseite.PartnerActivity"
            android:exported="false"
            android:parentActivityName=".webseite.WebseiteActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".webseite.RollenActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".webseite.VorschauActivity"
            android:exported="false" />

    </application>

</manifest>
